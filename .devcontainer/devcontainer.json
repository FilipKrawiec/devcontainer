{
  "name": "Master Dev Workspace",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devws",
  "workspaceFolder": "/projects",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "serverpod.serverpod"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "postCreateCommand": "just link-plugins 2>/dev/null || true",
  "postStartCommand": "just link-plugins 2>/dev/null || true; docker run -d --name master_dev_preview_sidecar --restart unless-stopped -p 8383:80 -v devws_projects:/usr/share/nginx/html:ro nginx:alpine /bin/sh -c 'printf \"server {\\n    listen 80;\\n    root /usr/share/nginx/html;\\n    autoindex on;\\n    autoindex_exact_size off;\\n    autoindex_localtime on;\\n    charset utf-8;\\n    add_header Cache-Control \\\"no-cache, no-store, must-revalidate\\\";\\n}\\n\" > /etc/nginx/conf.d/default.conf && exec nginx -g \"daemon off;\"' 2>/dev/null || docker start master_dev_preview_sidecar 2>/dev/null || true",
  "forwardPorts": [
    3000,
    4000,
    5001,
    5173,
    8000,
    8080,
    8081,
    8082,
    8085,
    8383,
    9000,
    9099,
    9100,
    9199,
    54321,
    54323,
    54324
  ],
  "portsAttributes": {
    "3000": {
      "label": "Web App (Node.js / React / Next.js)",
      "onAutoForward": "notify"
    },
    "4000": {
      "label": "Firebase Emulator Suite UI",
      "onAutoForward": "notify"
    },
    "5001": {
      "label": "Firebase Functions Emulator",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "HTTP Server / Python (Django / FastAPI)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Flutter Web / Spring Boot / Web App",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Alternate Flutter Web / Metro Bundler",
      "onAutoForward": "notify"
    },
    "8082": {
      "label": "Serverpod Web Server / Insights",
      "onAutoForward": "notify"
    },
    "8085": {
      "label": "Firebase Firestore Emulator",
      "onAutoForward": "notify"
    },
    "8383": {
      "label": "HTML Preview Sidecar (Nginx)",
      "onAutoForward": "notify"
    },
    "9000": {
      "label": "Backend Service / Firebase Realtime DB",
      "onAutoForward": "notify"
    },
    "9099": {
      "label": "Firebase Auth Emulator",
      "onAutoForward": "notify"
    },
    "9100": {
      "label": "Flutter DevTools",
      "onAutoForward": "notify"
    },
    "9199": {
      "label": "Firebase Storage Emulator",
      "onAutoForward": "notify"
    },
    "54321": {
      "label": "Supabase API Gateway (Kong)",
      "onAutoForward": "notify"
    },
    "54323": {
      "label": "Supabase Studio UI",
      "onAutoForward": "notify"
    },
    "54324": {
      "label": "Supabase Inbucket (Email Testing)",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose"
}
