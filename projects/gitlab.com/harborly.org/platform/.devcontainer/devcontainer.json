{
  "name": "harborly.org--platform",
  "image": "devws-polyglot:latest",
  "remoteUser": "vscode",
  "workspaceMount": "source=devws_harborly.org--platform_repo,target=/workspace,type=volume",
  "workspaceFolder": "/workspace/gitlab.com/harborly.org/platform",
  "mounts": [
    "source=/Users/filip/.docker/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/Users/filip/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "containerEnv": {
    "OLLAMA_HOST": "http://host.docker.internal:11434"
  }
}
