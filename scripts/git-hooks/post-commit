#!/usr/bin/env bash
# Git post-commit hook: Refresh local SDLC plugin when committing on main branch.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CURRENT_BRANCH="$(git -C "${REPO_ROOT}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

if [[ "${CURRENT_BRANCH}" == "main" ]]; then
  echo "=== [git-hook:post-commit] Main branch commit detected: Refreshing local plugins ==="
  if command -v just >/dev/null 2>&1; then
    (cd "${REPO_ROOT}" && just refresh-plugins)
  else
    target_dir="${AGY_IDE_PLUGIN_DIR:-"$HOME/.gemini/config/plugins"}"
    mkdir -p "${target_dir}"
    for dir in "${REPO_ROOT}"/plugins/*; do
      [ -d "$dir" ] || continue
      pkg="filipkrawiec-$(basename "$dir")"
      rm -rf "${target_dir}/${pkg}"
      cp -r "$dir" "${target_dir}/${pkg}"
    done
    echo "Refreshed local plugin installations."
  fi
fi
