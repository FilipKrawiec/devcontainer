set dotenv-load := true

# List available recipes
default:
    @just --list

# Start local infrastructure dependencies (PostgreSQL, Kafka, Grafana, etc.)
up:
    docker compose up -d --wait

# Stop local infrastructure dependencies
down:
    docker compose down

# Destroy persistent data volumes
purge:
    docker compose down -v

# Inner Loop: Unit + Component Tests + Linters
unit comp="":
    #!/usr/bin/env bash
    if [ -n "{{comp}}" ]; then \
        if [ -f "components/{{comp}}/justfile" ]; then \
            cd components/{{comp}} && just unit; \
        fi; \
    else \
        for d in components/*/; do \
            if [ -f "$d/justfile" ]; then (cd "$d" && just unit); fi; \
        done; \
    fi

# Outer Loop: Integration Tests
integration:
    docker compose -f compose.test.yaml up --exit-code-from test-runner

# Full Verification Gate
verify:
    @just unit
    @just integration
    @echo "=== Full Verification PASS ==="

# Microservice Deploy
deploy-service comp env="staging":
    #!/usr/bin/env bash
    if [ -f "components/{{comp}}/justfile" ]; then \
        cd components/{{comp}} && just deploy {{env}}; \
    fi

# Monolith Deploy via Ansible
deploy-monolith env="staging":
    #!/usr/bin/env bash
    if [ -f "components/monolith/.deploy/ansible/site.yml" ]; then \
        ansible-playbook -i components/monolith/.deploy/ansible/inventory/{{env}} components/monolith/.deploy/ansible/site.yml; \
    fi

# Single Atomic Helm Upgrade across whole repo via Umbrella Chart
deploy-all env="staging":
    helm dependency update deploy/umbrella-chart
    helm upgrade --install monorepo-release deploy/umbrella-chart -f deploy/umbrella-chart/values-{{env}}.yaml
