#!/usr/bin/env bash

set -euo pipefail

SSH_DIR="$HOME/.ssh"
KEY_PATH="$SSH_DIR/id_ed25519"
KEY_COMMENT="${USER}@$(hostname -s 2>/dev/null || hostname)"

mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"

if [[ ! -f "${KEY_PATH}.pub" ]]; then
  echo "creating SSH key: ${KEY_PATH}"
  ssh-keygen -t ed25519 -C "$KEY_COMMENT" -f "$KEY_PATH" -N ""
fi

if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
  eval "$(ssh-agent -s)" >/dev/null
fi

if ssh-add --apple-use-keychain "$KEY_PATH" >/dev/null 2>&1; then
  :
else
  ssh-add "$KEY_PATH" >/dev/null 2>&1 || true
fi

echo
echo "add this SSH public key to GitLab:"
cat "${KEY_PATH}.pub"
echo
echo "GitLab SSH keys: https://gitlab.com/-/user_settings/ssh_keys"
